{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "path": "/usr/share/fastfetch/kickos.txt"
  },
  "display": {
    "separator": " :: ",
    "color": {
      "keys": "blue",
      "title": "magenta"
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "key": "OS",
      "format": "KickOS Arch"
    },
    "kernel",
    "packages",
    "shell",
    "de",
    "wm",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "display",
    {
      "type": "custom",
      "key": "Gamepad",
      "format": "Detected"
    },
    "localip",
    "uptime",
    {
      "type": "custom",
      "key": "KickBoost",
      "format": "print('Unknown')",
      "command": "cat /tmp/kickboost-mode 2>/dev/null || echo 'balanced'"
    },
    {
      "type": "custom",
      "key": "Updates",
      "format": "print('0')",
      "command": "checkupdates 2>/dev/null | wc -l || echo '0'"
    },
    "colors"
  ]
}
