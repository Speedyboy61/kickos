#!/bin/bash
# KickOS update notification daemon

while true; do
    UPDATE_COUNT=$(checkupdates 2>/dev/null | wc -l)

    if [ "$UPDATE_COUNT" -gt 0 ]; then
        notify-send "KickOS Updates" \
            "$UPDATE_COUNT update(s) available" \
            --icon=system-software-update \
            --action="update=Open KickUpdate"
    fi

    sleep 21600
done
